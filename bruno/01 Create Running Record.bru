meta {
  name: 01 Create Running Record
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/running_records
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "running_record": {
      "run_id": "11111111-1111-4111-8111-111111111331",
      "runner_id": "22222222-2222-4222-8222-222222332222",
      "distance_meters": 25000,
      "duration_seconds": 1800,
      "occurred_at": "2026-09-30T12:00:00Z",
      "notes": "Evening run"
    }
  }
}

script:post-response {
  const body = res.getBody()
  if (res.getStatus() === 201 && body.id) {
    bru.setEnvVar('recordId', String(body.id))
  }
}

tests {
  test('creates a running record', function () {
    expect(res.getStatus()).to.equal(201)
    expect(res.getBody()).to.have.property('id')
  })
}

docs {
  Creates a running record and saves its returned `id` as the local environment's
  `recordId` for the remaining demo requests.
}
